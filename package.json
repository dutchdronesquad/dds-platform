{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "browser:install": "playwright install chromium",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "npm run wayfinder:generate && oxlint --fix",
        "lint:check": "npm run wayfinder:generate && oxlint",
        "types:check": "npm run wayfinder:generate && tsc --noEmit",
        "wayfinder:generate": "php artisan wayfinder:generate --with-form --no-interaction"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@types/node": "^26.0.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "oxlint": "^1.78.0",
        "playwright": "^1.61.1",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.8.0"
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/passkeys": "^0.4.0",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-popover": "^1.1.19",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@tailwindcss/vite": "^4.1.11",
        "@tanstack/react-table": "^8.21.3",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.0",
        "date-fns": "^4.4.0",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^3.0.0",
        "lucide-react": "^0.577.0",
        "react": "^19.2.0",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.0",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.7.2",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.62.4",
        "@rollup/rollup-win32-x64-msvc": "4.62.4",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
