APP_NAME="Dutch Drone Squad"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://dds-platform.ddev.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1
NIGHTWATCH_COMMAND_SAMPLE_RATE=1.0
NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1.0

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=media
MEDIA_DISK=media
MEDIA_MAX_FILE_SIZE=20971520
MEDIA_PREFIX=media-library
MEDIA_VERSION_URLS=true
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Local defaults below match the DDEV Valkey backend; use a managed Valkey-compatible service in production.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@dutchdronesquad.nl"
MAIL_FROM_NAME="${APP_NAME}"

# Local defaults below match the ddev MinIO add-on. Use a bucket-scoped R2 token in production.
MEDIA_AWS_ACCESS_KEY_ID=ddevminio
MEDIA_AWS_SECRET_ACCESS_KEY=ddevminio
MEDIA_AWS_DEFAULT_REGION=auto
MEDIA_AWS_BUCKET=dds-platform-media
MEDIA_AWS_ENDPOINT=http://minio:10101
MEDIA_AWS_URL=https://dds-platform.ddev.site:10101/dds-platform-media
MEDIA_AWS_USE_PATH_STYLE_ENDPOINT=true

# Backups use a separate private bucket and bucket-scoped credentials.
BACKUP_AWS_ACCESS_KEY_ID=ddevminio
BACKUP_AWS_SECRET_ACCESS_KEY=ddevminio
BACKUP_AWS_DEFAULT_REGION=auto
BACKUP_AWS_BUCKET=dds-platform-backups
BACKUP_AWS_ENDPOINT=http://minio:10101
BACKUP_AWS_USE_PATH_STYLE_ENDPOINT=true

BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
BACKUP_MAX_AGE_IN_DAYS=1
BACKUP_MAX_STORAGE_MEGABYTES=10240

VITE_APP_NAME="${APP_NAME}"
