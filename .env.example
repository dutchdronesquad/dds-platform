APP_NAME="Dutch Drone Squad"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://dds-platform.ddev.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
MEDIA_DISK=s3
MEDIA_MAX_FILE_SIZE=20971520
MEDIA_PREFIX=media-library
MEDIA_VERSION_URLS=true
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@dutchdronesquad.nl"
MAIL_FROM_NAME="${APP_NAME}"

# Local defaults below match the ddev MinIO add-on; use R2 credentials in production.
AWS_ACCESS_KEY_ID=ddevminio
AWS_SECRET_ACCESS_KEY=ddevminio
AWS_DEFAULT_REGION=auto
AWS_BUCKET=dds-platform-media
AWS_ENDPOINT=http://minio:10101
AWS_URL=https://dds-platform.ddev.site:10101/dds-platform-media
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
