#!/usr/bin/env bash

## Description: Run Pest using the shared TIA baseline from GitHub Actions
## Usage: tia [pest options]
## Example: "ddev tia"

set -euo pipefail

if ! command -v gh >/dev/null 2>&1; then
    echo 'GitHub CLI (gh) is required on the host: https://cli.github.com'
    exit 1
fi

if ! gh auth status >/dev/null 2>&1; then
    echo 'GitHub CLI is not authenticated. Run: gh auth login'
    exit 1
fi

xdebug_was_enabled="$(ddev exec php -r 'echo extension_loaded("xdebug") ? "1" : "0";')"
token_file=""

function cleanup() {
    if [[ -n "${token_file}" ]]; then
        rm -f "${token_file}"
    fi

    if [[ "${xdebug_was_enabled}" == "0" ]]; then
        ddev xdebug off >/dev/null
    fi
}

trap cleanup EXIT

if [[ "${xdebug_was_enabled}" == "0" ]]; then
    ddev xdebug on
fi

token_file="$(mktemp "${DDEV_APPROOT}/.ddev/.tia-gh-token.XXXXXX")"
chmod 600 "${token_file}"
gh auth token > "${token_file}"
token_file_name="${token_file##*/}"

ddev exec sh /mnt/ddev_config/tia-runner "/mnt/ddev_config/${token_file_name}" "$@"
